+++ b/src/drivers/tandy4.c
@@ -0,0 +1,81 @@
+/* Tandy 320x200x16 mode 09h. Four 8K banks, high nibble first.
+ * Memory surfaces use the same packed pixels without scanline interleaving.
+ * Screen writes use the physical segment certified by the cooperating kernel
+ * (9800h on original Tandy, 1800h on expanded PCjr).
+ * Deliberately does not program page registers or claim conventional RAM.
+ */
+#include "device.h"
+#include "vgaplan4.h"
+#include "fb.h"
+#include "genmem.h"
+DEFINE_applyOpR
+
+extern unsigned int tandy_screen_segment;
+
+static FARADDR pixeladdr(PSD p, MWCOORD x, MWCOORD y)
+{
+    if (p->flags & PSF_SCREEN)
+        return MK_FP(tandy_screen_segment, ((unsigned)(y & 3) << 13) +
+                     (unsigned)(y >> 2) * 160 + (x >> 1));
+    return (FARADDR)(p->addr + (unsigned)y * p->pitch + (x >> 1));
+}
+static MWPIXELVAL readpixel(PSD p, MWCOORD x, MWCOORD y)
+{
+    return (*pixeladdr(p,x,y) >> ((1-(x&1))*4)) & 15;
+}
+static void putpixel(PSD p, MWCOORD x, MWCOORD y, MWPIXELVAL c, int op)
+{
+    FARADDR a = pixeladdr(p,x,y);
+    unsigned shift = (1-(x&1))*4;
+    unsigned char old = *a;
+    unsigned value = op == MWROP_COPY ? c : applyOpR(op,c,(old>>shift)&15);
+    *a = (old & ~(15<<shift)) | ((value & 15)<<shift);
+}
+static void drawpixel(PSD p, MWCOORD x, MWCOORD y, MWPIXELVAL c)
+{
+    putpixel(p,x,y,c,gr_mode);
+}
+static void hline(PSD p, MWCOORD x, MWCOORD end, MWCOORD y, MWPIXELVAL c)
+{
+    FARADDR a;
+    if (gr_mode == MWROP_COPY) {
+        if ((x&1) && x<=end) putpixel(p,x++,y,c,MWROP_COPY);
+        a = pixeladdr(p,x,y);
+        while (x<end) { *a++ = (c&15)*17; x+=2; }
+        if (x<=end) putpixel(p,x,y,c,MWROP_COPY);
+    } else while (x<=end) putpixel(p,x++,y,c,gr_mode);
+}
+static void vline(PSD p, MWCOORD x, MWCOORD y, MWCOORD end, MWPIXELVAL c)
+{
+    while (y<=end) putpixel(p,x,y++,c,gr_mode);
+}
+static void blit(PSD d, MWCOORD dx, MWCOORD dy, MWCOORD w, MWCOORD h,
+                 PSD s, MWCOORD sx, MWCOORD sy, int op)
+{
+    MWCOORD i,j,x,y;
+    MWPIXELVAL c;
+    int transparent = op == MWROP_SRCTRANSCOPY;
+    int backward = d==s && (dy>sy || (dy==sy && dx>sx));
+    if (op>MWROP_SIMPLE_MAX) op=MWROP_COPY;
+    for (j=0;j<h;++j) {
+        y=backward ? h-1-j : j;
+        for (i=0;i<w;++i) {
+            x=backward ? w-1-i : i;
+            c = readpixel(s,sx+x,sy+y);
+            if (!transparent || c != s->transcolor)
+                putpixel(d,dx+x,dy+y,c,op);
+        }
+    }
+}
+static SUBDRIVER packed4 = {
+    drawpixel, readpixel, hline, vline, gen_fillrect, blit
+};
+PSUBDRIVER tandyplan4[4] = { &packed4 };
+PSUBDRIVER memplan4[4] = { &packed4 };
+int tandy_init(PSD p)
+{
+    p->pitch=160;
+    p->addr=0;
+    p->size=0;
+    return 1;
+}
