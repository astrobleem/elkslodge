+/* Explicit color launcher. Keeps the installed monochrome server unchanged.
+ * Owns both children, restores console/termios after normal exit or crash. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <errno.h>
+#include <sys/wait.h>
+#include <sys/ioctl.h>
+#include <termios.h>
+#include <linuxmt/mem.h>
+#include <linuxmt/ntty.h>
+#include "nano-X.h"
+extern void int10(int ax,int bx);
+static volatile int stopped;
+static void stop(int sig) { (void)sig; stopped=1; }
+static int finished(pid_t child) {
+    int status;
+    pid_t result=waitpid(child,&status,WNOHANG);
+    return result==child || (result==(pid_t)-1 && errno==ECHILD);
+}
+static int stop_child(pid_t child) {
+    int n;
+    kill(child,SIGTERM);
+    for(n=0;n<20;n++) { if(finished(child)) return 1; usleep(50000UL); }
+    kill(child,SIGKILL);
+    for(n=0;n<20;n++) { if(finished(child)) return 1; usleep(50000UL); }
+    return 0; /* Never restore video while a child may still be running. */
+}
+int main(void)
+{
+    int fd,k,n,ready=0,serverdone=0,appdone=0;
+    unsigned reserved=0;
+    pid_t server,app;
+    struct termios saved;
+    char *console=getenv("CONSOLE");
+    k=open("/dev/kmem",O_RDONLY);
+    if (k>=0) {
+        if (ioctl(k,MEM_GETTANDY,&reserved)<0 || reserved!=0x9800) {
+            reserved=0;
+            if (ioctl(k,MEM_GETPCJR,&reserved)<0 || reserved!=0x1800) reserved=0;
+        }
+    }
+    if(!reserved) {
+        if(k>=0)close(k);
+        fprintf(stderr,"Color RAM is not reserved; use the supporting Tandy or PCjr kernel.\n");return 1;
+    }
+    close(k);
+    if(getenv("NXDISPLAY")) {
+        fprintf(stderr,"Unset NXDISPLAY before local color mode.\n");return 1;
+    }
+    if(access(GR_NAMED_SOCKET,F_OK)==0) {
+        fprintf(stderr,"Close the running Nano-X session first.\n");return 1;
+    }
+    fd=open(console?console:"/dev/tty1",O_RDWR|O_NONBLOCK);
+    if(fd<0 || tcgetattr(fd,&saved)<0) { if(fd>=0)close(fd);return 1; }
+    signal(SIGINT,stop);signal(SIGTERM,stop);
+    server=fork();
+    if(server==(pid_t)-1) { close(fd);return 1; }
+    if(!server) { execl("/bin/nano-color","nano-color",NULL);_exit(1); }
+    for(n=0;n<200 && !stopped;n++) {
+        serverdone=finished(server);
+        if(serverdone) break;
+        if(access(GR_NAMED_SOCKET,F_OK)==0) { ready=1;break; }
+        usleep(50000UL);
+    }
+    if(!ready || stopped) {
+        if(!serverdone) stop_child(server);
+        /* Driver owns early cleanup. Do not reset another server after refusal. */
+        close(fd);return 1;
+    }
+    app=fork();
+    if(!app) { execl("/bin/nxstart","nxstart",NULL);_exit(1); }
+    if(app==(pid_t)-1) appdone=1;
+    while(!stopped && !serverdone && !appdone) {
+        serverdone=finished(server);
+        appdone=finished(app);
+        if(!serverdone && !appdone) usleep(50000UL);
+    }
+    if(!appdone) appdone=stop_child(app);
+    if(!serverdone) serverdone=stop_child(server);
+    if(!appdone || !serverdone) { close(fd);return 1; }
+    /* Both children are stopped: no concurrent graphics writes can follow. */
+    int10(3,0);
+    ioctl(fd,DCREL_GRAPH,0);
+    tcsetattr(fd,TCSANOW,&saved);
+    close(fd);
+    return 0;
+}
