+/*
+ * TANDY Screen Driver for ELKS
+ * 	For TANDY, 16 color, 320x200 resolution
+ * 	This driver uses bios for graphical setting.
+ *
+ *      This driver is created and modifed, based on EGA/VGA driver.
+ * 	This file itself doesn't know about any planar or packed arrangement, relying
+ * 	on routines in tandy4.c for drawing.
+ *
+ *      Copyright (c) 1999 Greg Haerr <greg@censoft.com>
+ *
+ * T. Yamada 2024
+ */
+
+#include <linuxmt/ntty.h>
+#include <linuxmt/mem.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include "device.h"
+#include "vgaplan4.h"
+#include "genmem.h"
+#if ROMFONT
+#include "romfont.h"
+#else
+#include "genfont.h"
+#endif
+
+#define _MK_FP(seg,off) ((void __far *)((((unsigned long)(seg)) << 16) | (off)))
+
+/* TANDY driver entry points*/
+static PSD  TANDY_open(PSD psd);
+static void TANDY_close(PSD psd);
+static void TANDY_getscreeninfo(PSD psd, PMWSCREENINFO psi);;
+static void TANDY_setpalette(PSD psd,int first,int count, MWPALENTRY *pal);
+
+SCREENDEVICE	scrdev = {
+    0, 0, 0, 0, 0, 0, 0, NULL, 0, NULL, 0, 0, 0, 0, 0, 0,
+#if ROMFONT
+        pcrom_fonts,
+#else
+        gen_fonts,
+#endif
+        TANDY_open,
+        TANDY_close,
+        TANDY_setpalette,
+        TANDY_getscreeninfo,
+        gen_allocatememgc,
+        gen_mapmemgc,
+        gen_freememgc,
+        0,                      /* gen_setportrait*/
+        NULL,                   /* PreSelect*/
+};
+
+/* operating mode*/
+static int console_fd = -1;
+unsigned int tandy_screen_segment;
+
+/* int10 functions*/
+#define FNGR320x200	0x0009	/* function for graphics mode 320x200x16*/
+#define FNTEXT		0x0003	/* function for 80x25 text mode*/
+
+static PSD
+TANDY_open(PSD psd)
+{
+	extern PSUBDRIVER tandyplan4[4];
+	extern int tandy_init(PSD);
+	char *console;
+
+	/* Require kernel evidence, never an environment-variable assertion. */
+	{
+		unsigned int reserved = 0;
+		int fd = open("/dev/kmem", O_RDONLY);
+		if (fd >= 0) {
+            if (ioctl(fd, MEM_GETTANDY, &reserved) < 0 || reserved != 0x9800) {
+                reserved = 0;
+                if (ioctl(fd, MEM_GETPCJR, &reserved) < 0 || reserved != 0x1800)
+                    reserved = 0;
+            }
+        }
+        if (!reserved) {
+			if (fd >= 0) close(fd);
+			fprintf(stderr, "Tandy/PCjr: supporting kernel video reservation required\n");
+			return NULL;
+		}
+		tandy_screen_segment = reserved;
+		close(fd);
+	}
+
+	/* The text console shares TANDY video RAM. Keep console writes and
+	 * virtual-console switches out of the framebuffer until text mode
+	 * is restored. Do not use stderr: applications may redirect it. */
+	/* Match kbd_tty exactly, including when the caller uses another tty. */
+	console = getenv("CONSOLE");
+	console_fd = open(console ? console : "/dev/tty1", O_WRONLY | O_NONBLOCK);
+
+	if (console_fd < 0)
+		return NULL;
+	if (ioctl(console_fd, DCGET_GRAPH, 0) < 0) {
+		close(console_fd);
+		console_fd = -1;
+		return NULL;
+	}
+
+	int10(FNGR320x200, 0);
+	if ((GETBYTE_FP(MK_FP(0x0040, 0x0049)) & 0x7f) != 9) {
+		TANDY_close(psd);
+		fprintf(stderr, "Tandy: BIOS did not enter mode 09h\n");
+		return NULL;
+	}
+
+	/* init driver variables depending on tandy mode*/
+	psd->xres = psd->xvirtres = 320;
+	psd->yres = psd->yvirtres = 200;
+	psd->planes = 1;
+	psd->pixtype = MWPF_PALETTE;
+	psd->flags = PSF_SCREEN;
+	psd->bpp = 4;
+	psd->ncolors = 16;
+    psd->data_format = MWIF_PAL4;
+    set_subdriver(psd, tandyplan4[0]);
+
+	tandy_init(psd);              /* init planes driver (sets psd->linelen)*/
+
+#if ROMFONT
+	pcrom_init(psd);            /* init pc rom font routines*/
+#endif
+	return psd;
+}
+
+static void
+TANDY_close(PSD psd)
+{
+	int10(FNTEXT, 0);           /* restore text before releasing ownership */
+	if (console_fd >= 0) {
+		ioctl(console_fd, DCREL_GRAPH, 0);
+		close(console_fd);
+		console_fd = -1;
+	}
+}
+
+static void
+TANDY_getscreeninfo(PSD psd, PMWSCREENINFO psi)
+{
+	psi->rows = psd->yvirtres;
+	psi->cols = psd->xvirtres;
+	psi->planes = psd->planes;
+	psi->bpp = psd->bpp;
+    psi->data_format = psd->data_format;
+	psi->ncolors = psd->ncolors;
+	psi->pixtype = psd->pixtype;
+	psi->fonts = NUMBER_FONTS;
+
+	/* 320x200 */
+	psi->xdpcm = 13;	/* assumes screen width of 24 cm*/
+	psi->ydpcm = 11;	/* assumes screen height of 18 cm*/
+}
+
+static void
+TANDY_setpalette(PSD psd,int first,int count, MWPALENTRY *pal)
+{
+	/* not yet implemented, std 16 color palette assumed*/
+}
