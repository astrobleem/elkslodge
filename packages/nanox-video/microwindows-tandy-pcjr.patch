@@ -0,0 +1,34 @@
+/* Manual recovery after the graphics server has stopped unexpectedly. */
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <termios.h>
+#include <linuxmt/ntty.h>
+extern void int10(int ax, int bx);
+int main(int argc, char **argv)
+{
+    int fd;
+    struct termios term;
+    char *console;
+    if (argc != 2 || strcmp(argv[1], "--text")) {
+        fprintf(stderr,"Usage: vidreset --text (only after graphics server has stopped)\n");
+        return 1;
+    }
+    console=getenv("CONSOLE");
+    fd=open(console?console:"/dev/tty1",O_RDWR|O_NONBLOCK);
+    if(fd<0) { perror("console"); return 1; }
+    int10(3,0);
+    if(ioctl(fd,DCREL_GRAPH,0)<0) { close(fd); return 1; }
+    if(tcgetattr(fd,&term)==0) {
+        term.c_lflag |= ECHO|ICANON|ISIG;
+        term.c_iflag |= ICRNL|BRKINT;
+        term.c_cc[VMIN]=1;
+        term.c_cc[VTIME]=0;
+        tcsetattr(fd,TCSANOW,&term);
+    }
+    close(fd);
+    return 0;
+}
