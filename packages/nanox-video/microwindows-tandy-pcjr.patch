+/* Read-only BIOS video/memory probe for ELKS on a known Tandy 1000.
+ * No BIOS mode calls, register writes, or framebuffer writes. */
+#include <stdio.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <linuxmt/mem.h>
+int main(void)
+{
+    volatile unsigned char __far *bda = (volatile unsigned char __far *)0x00400000UL;
+    unsigned i, reserved = 0;
+    int fd;
+    unsigned ram = bda[0x13] | ((unsigned)bda[0x14] << 8);
+    printf("BIOS conventional memory: %u KB\n",ram);
+    printf("BIOS video mode: %02x; columns: %u\n",bda[0x49],bda[0x4a]|((unsigned)bda[0x4b]<<8));
+    printf("BIOS video page bytes: %u; page offset: %04x\n",bda[0x4c]|((unsigned)bda[0x4d]<<8),bda[0x4e]|((unsigned)bda[0x4f]<<8));
+    printf("BDA 0040:0080..008f (raw):");
+    for(i=0x80;i<0x90;i++) printf(" %02x",bda[i]);
+    printf("\n");
+    fd=open("/dev/kmem",O_RDONLY);
+    if(fd>=0 && ioctl(fd,MEM_GETTANDY,&reserved)==0 && reserved==0x9800)
+        printf("ELKS kernel: 32K Tandy video RAM reserved at 98000\n");
+    else if(fd>=0 && ioctl(fd,MEM_GETPCJR,&reserved)==0 && reserved==0x1800)
+        printf("ELKS kernel: 32K PCjr video RAM reserved at 18000\n");
+    else printf("ELKS kernel: color reservation NOT confirmed\n");
+    if(fd>=0) close(fd);
+    printf("No video mode or memory settings changed.\n");
+    return 0;
+}
