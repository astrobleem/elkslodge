#!/bin/sh
# ELKSLODGE 0.5 upgrade; keep the configured local companion.
umask 077
server=${ELKSLODGE_SERVER-}
if test -z "$server"; then
    if test -f /etc/elkslodge; then
        server=`cat /etc/elkslodge`
    else
        echo Set ELKSLODGE_SERVER to your local companion http://host:port first.
        exit 1
    fi
fi
if test ! -f /bin/elkslodge; then
    echo No installed client. Use the first-time get script.
    exit 1
fi
if test -d /.lodge; then
    echo Finish or recover the pending package install first.
    exit 1
fi
mkdir /bin/.lodgeup || exit 1
curl -o /bin/.lodgeup/new "$server/elkslodge-0.5"
if test $? -ne 0; then
    echo Download failed. Existing client unchanged.
    rm -f /bin/.lodgeup/new
    rmdir /bin/.lodgeup
    exit 1
fi
n=`wc -c < /bin/.lodgeup/new`
if test "$n" -ne 10320; then
    echo Wrong download size. Existing client unchanged.
    rm -f /bin/.lodgeup/new
    rmdir /bin/.lodgeup
    exit 1
fi
chmod 755 /bin/.lodgeup/new || exit 1
mv /bin/elkslodge /bin/.lodgeup/old || exit 1
if mv /bin/.lodgeup/new /bin/elkslodge; then
    rm /bin/.lodgeup/old
    rmdir /bin/.lodgeup
    echo ELKSLODGE upgraded. Server configuration preserved.
    elkslodge list
else
    mv /bin/.lodgeup/old /bin/elkslodge
    echo Upgrade failed. Check /bin/.lodgeup before retrying.
    exit 1
fi
